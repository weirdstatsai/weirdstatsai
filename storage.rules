rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Shareable card preview (OG) images: world-readable so social crawlers
    // can fetch them; only signed-in users can write, PNG, capped at 5 MB.
    match /og/{cardId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/png');
    }

    // Owner-uploaded card background photos (fact-card image layer).
    // World-readable (cards are shareable); only the owner may upload/replace/
    // delete their own, image types only, capped at 5 MB (the app compresses
    // to ~200 KB client-side before upload). request.resource == null is the
    // DELETE case — no content checks apply there.
    match /card-media/{uid}/{cardId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/(jpeg|png|webp)')));
    }
  }
}
