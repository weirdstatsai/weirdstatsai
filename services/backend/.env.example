OPENAI_API_KEY=your-openai-api-key-here

# Firebase Admin SDK — used for Firestore persistence and verifying ID tokens
FIREBASE_PROJECT_ID=weirdstatsai-aaaf7
FIREBASE_SERVICE_ACCOUNT_KEY=firebase-adminsdk.json

# Stripe billing
# Get these from https://dashboard.stripe.com (use test keys during development).
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PRICE_ID=price_your_recurring_premium_price_id
# From `stripe listen --forward-to localhost:8000/api/billing/webhook`
# (dev) or the dashboard webhook endpoint (prod).
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Fallback URL Stripe returns to after checkout (the client usually sends its own).
BILLING_RETURN_URL=http://localhost:8100
