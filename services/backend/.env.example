OPENAI_API_KEY=your-openai-api-key-here

# Firebase Admin SDK (Firestore access). Point to a weirdstats-ai service
# account key, or rely on Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/weirdstats-ai-adminsdk.json
FIREBASE_PROJECT_ID=weirdstats-ai

# ── Stripe billing (premium) ────────────────────────────────────────────────
# Until ALL of these are set, the /api/billing/* endpoints return 503 and the
# app runs exactly as before. Get keys at https://dashboard.stripe.com (use the
# TEST keys first — sk_test_… — then swap to live once verified).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs (create 3 Prices on ONE Product in the Stripe dashboard):
STRIPE_PRICE_MONTHLY=price_xxx          # recurring monthly ($9.99/mo)
STRIPE_PRICE_MONTHLY_ONCE=price_xxx     # one-time ($9.99, 30-day pass)
STRIPE_PRICE_YEARLY=price_xxx           # recurring yearly ($100/yr)
# Fallback base URL for Checkout success/cancel redirects (the app normally
# sends its own origin; this is the default when it doesn't).
FRONTEND_URL=https://weirdstats.ai
