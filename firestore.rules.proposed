// PROPOSED hardened Firestore rules — NOT deployed.
//
// These make drafts/private cards owner-only and keep only published/home cards
// world-readable. They CANNOT be deployed as-is: the app's Explore, Home, and
// public-profile pages currently fetch the whole `stats` collection and filter
// by publishStatus in the client. Per-document rules reject an unconstrained
// query that could return non-readable docs, so those pages would break.
//
// To ship these, first (in the frontend):
//   - explore.page.ts:   ref.where('publishStatus','==','published').orderBy('createdAt','desc')
//   - home.page.ts:      constrain to homeFeatured == true (already filtered — confirm server-side)
//   - public-profile:    ref.where('createdBy','==',uid).where('publishStatus','==','published')
//   and add the matching composite indexes to firestore.indexes.json.
// Then validate with the Firestore emulator (@firebase/rules-unit-testing) and
// deploy the rules TOGETHER with that frontend.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /stats/{statId} {
      function isOwner() {
        return request.auth != null && resource.data.createdBy == request.auth.uid;
      }
      function willOwn() {
        return request.auth != null && request.resource.data.createdBy == request.auth.uid;
      }

      allow read: if resource.data.publishStatus == 'published'
                  || resource.data.homeFeatured == true
                  || isOwner()
                  || isAdmin();

      allow create: if willOwn() || isAdmin();

      allow update: if isAdmin()
                    || (willOwn() && (
                          resource.data.createdBy == request.auth.uid ||
                          resource.data.createdBy == 'Anonymous' ||
                          !('createdBy' in resource.data)
                       ));

      allow delete: if isOwner() || isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null &&
                      (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/plan/{docId} {
      allow read, write: if request.auth != null &&
                            (request.auth.uid == userId || isAdmin());
    }
  }
}
