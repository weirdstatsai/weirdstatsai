rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stats collection — written by the backend service account.
    // Readable by anyone (Explore / discover feed).
    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    // User profile — only the owner can read/write.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Plan subcollection — owner only.
    match /users/{userId}/plan/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
