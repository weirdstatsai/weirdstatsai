rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper — check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Stats — public read, backend writes.
    // NOTE: hardened owner-only rules are drafted in firestore.rules.proposed
    // but NOT live yet: Explore/Home/public-profile currently fetch-all and
    // filter client-side, which per-document rules reject. Tightening requires
    // refactoring those queries to `where publishStatus == 'published'` +
    // composite indexes + emulator testing first (see firestore.rules.proposed).
    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    // Users — owner can read/write their own; admin can read/write any
    match /users/{userId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null &&
                      (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/plan/{docId} {
      allow read, write: if request.auth != null &&
                            (request.auth.uid == userId || isAdmin());
    }
  }
}
