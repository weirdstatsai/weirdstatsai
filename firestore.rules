rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper — check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Stats — the single collection holding every card (drafts, private, public).
    //
    // A card is world-readable only once it is published (or admin-featured on
    // Home). A user's own drafts/private cards are readable only by them. The
    // backend runs on the Admin SDK and bypasses these rules, so server-side
    // writes (generation cache) are unaffected. Validated with the Firestore
    // emulator (20/20 rules tests) against the app's real query shapes.
    match /stats/{statId} {
      function isOwner() {
        return request.auth != null && resource.data.createdBy == request.auth.uid;
      }
      // The document AFTER the write is owned by the requester.
      function willOwn() {
        return request.auth != null && request.resource.data.createdBy == request.auth.uid;
      }
      // Enabling the curated-feed flags is admin-only. A non-admin write may
      // leave a flag as-is or turn it OFF (e.g. an owner making a card private
      // clears them), but may never turn one ON that wasn't already on. Missing
      // field defaults to false, so a plain owner edit that omits them passes.
      function noNonAdminFeedEnable() {
        return (request.resource.data.get('showOnHome', false) == false
                || resource.data.get('showOnHome', false) == true)
            && (request.resource.data.get('showOnExplore', false) == false
                || resource.data.get('showOnExplore', false) == true);
      }

      allow read: if resource.data.publishStatus == 'published'
                  || resource.data.homeFeatured == true
                  || resource.data.showOnHome == true
                  || resource.data.showOnExplore == true
                  || isOwner()
                  || isAdmin();

      // Creating a card client-side (rare — the backend normally creates it):
      // the new doc must be owned by the requester, and a non-admin can't
      // create it already flagged onto the Home/Explore feeds.
      allow create: if isAdmin()
                    || (willOwn()
                        && request.resource.data.get('showOnHome', false) == false
                        && request.resource.data.get('showOnExplore', false) == false);

      // Claiming an anonymous backend cache doc as your draft, or editing your
      // own card: the result must be owned by you, and you may only take over a
      // doc that is currently yours or unowned (the backend writes createdBy
      // "Anonymous" for cache copies). Non-admins can't touch the feed flags.
      allow update: if isAdmin()
                    || (willOwn()
                        && (
                          resource.data.createdBy == request.auth.uid ||
                          resource.data.createdBy == 'Anonymous' ||
                          !('createdBy' in resource.data)
                        )
                        && noNonAdminFeedEnable());

      allow delete: if isOwner() || isAdmin();
    }

    // Users — owner can read/write their own; admin can read/write any
    match /users/{userId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null &&
                      (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/plan/{docId} {
      allow read, write: if request.auth != null &&
                            (request.auth.uid == userId || isAdmin());
    }

    // Business contact-form leads. Written ONLY by the backend (Admin SDK,
    // which bypasses rules), so clients can't create/spam them. Readable only
    // by admins (for a future inbox view); never client-writable or public.
    match /contactMessages/{msgId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
